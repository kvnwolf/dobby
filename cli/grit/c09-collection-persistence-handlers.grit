engine biome(1.0)
language js(typescript, jsx)

// C9 — data-fetching: collections are read-only. A persistence handler on the
// collection options means writes bypass the server-function path entirely.
`createCollection($options)` as $call where {
  $options <: contains or {
    `onInsert: $insert`,
    `onUpdate: $update`,
    `onDelete: $delete`
  },
  register_diagnostic(span=$call, message="Collections are read-only — no persistence handlers. Writes go through server functions directly.", severity="error")
}

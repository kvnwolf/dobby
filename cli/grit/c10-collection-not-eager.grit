engine biome(1.0)
language js(typescript, jsx)

// C10 — data-fetching: the collection is an EAGER module-level export. A
// createCollection() call that is not the initializer of an `export const` sits
// inside a function body or a lazy accessor — the shape the convention rejects
// (startSync defaults to false, so constructing it during SSR is already inert).
`createCollection($...)` as $call where {
  not $call <: within `export const $name = $initializer` ,
  register_diagnostic(span=$call, message="Export the collection eagerly (export const xCollection = createCollection(…)) — startSync defaults to false, so constructing it during SSR is inert.", severity="error")
}
